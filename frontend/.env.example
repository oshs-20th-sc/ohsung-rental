# 브라우저용 Firebase Web App 설정입니다. 실제 값은 로컬 .env.local 또는 호스팅 플랫폼에 입력하세요.
# 아래 예시는 형식만 보여 주며 유효한 Firebase 프로젝트 값이 아닙니다.
# VITE_FIREBASE_API_KEY=your-firebase-web-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_APP_ID=1:PROJECT_NUMBER:web:APP_HASH
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 이 값들은 브라우저 번들에 공개됩니다. Firebase Admin 서비스 계정,
# 비공개 키, 관리자 비밀번호를 VITE_ 변수에 넣지 마세요.
