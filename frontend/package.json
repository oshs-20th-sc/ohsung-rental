{
  "name": "selectitem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host=localhost",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo",
    "dev:emulator": "vite --mode emulator",
    "build:demo": "vite build --mode demo",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-ohsung-rental --config ../firebase.json",
    "emulators:seed": "node scripts/seed-emulator.mjs",
    "test": "firebase emulators:exec --only auth,firestore --project demo-ohsung-rental --config ../firebase.json \"node --test --test-concurrency=1 tests/*.test.js\"",
    "build:release": "vite build --mode release",
    "students:provision": "node scripts/provision-students.mjs",
    "inventory:migrate": "node scripts/migrate-inventory.mjs"
  },
  "dependencies": {
    "firebase": "^13.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "firebase-admin": "14.5.1",
    "firebase-tools": "15.37.0",
    "globals": "^15.11.0",
    "vite": "^7.1.11"
  },
  "engines": {
    "node": "^24.22.3"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "firebase-tools": {
      "glob": "^14.0.6",
      "uuid@^9.0.1": "^11.1.1",
      "@google-cloud/pubsub": {
        "@opentelemetry/core": "^2.8.0"
      }
    }
  }
}
